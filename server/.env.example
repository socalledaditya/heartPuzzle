PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/heart-puzzle

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Seeded ONCE on first start (the only admin account)
ADMIN_NAME=Event Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword1

# Only these email domains may register (comma separated). Leave empty to allow any.
ALLOWED_EMAIL_DOMAINS=
# Set true only when the site is served over HTTPS
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# SMTP for OTP e-mails (Gmail: use an App Password). If SMTP_HOST is empty, OTPs print in the server console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Heart Puzzle <no-reply@example.com>"
